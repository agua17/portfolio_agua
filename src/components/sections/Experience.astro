---
import Section from "../Section.astro"
---

<Section
  id="experiencia"
  title="Experiencia y aprendizaje"
  eyebrow="TRAYECTORIA"
>
  <div class="timeline">
    <article class="timeline-item">
      <div class="timeline-date">
        NOV. 2025 — ACTUALIDAD<span>Formación continua</span>
      </div>
      <div>
        <h3>Desarrollo web: ampliación del perfil tecnológico</h3><p
          class="organization"
        >
          David Casas Arenas
        </p>
        <ul class="bullet-list">
          <li>
            Ampliación y consolidación de HTML, CSS y JavaScript: DOM, eventos y
            formularios.
          </li><li>
            Itinerario de aprendizaje orientado a continuar con React y Node.js.
          </li><li>
            Trabajo en ramas y entregas mediante pull requests en GitHub.
          </li><li>
            Revisión de código de compañeros y aplicación del feedback del
            profesor.
          </li>
        </ul>
      </div>
    </article>
    <article class="timeline-item">
      <div class="timeline-date">
        2024 — 2025<span>Proyectos para clientes</span>
      </div>
      <div>
        <h3>Webs para pequeños negocios</h3>
        <p class="organization">Proyectos independientes · Bohemia Colección</p>
        <ul class="bullet-list">
          <li>Creación y personalización de webs con WordPress, HTML y CSS.</li>
          <li>
            Configuración de catálogos con WooCommerce y formularios de
            solicitud de pedido.
          </li>
          <li>Publicación de la web de Bohemia Colección en Hostinger.</li>
        </ul>
        <a class="text-link" href="#bohemia"
          >Ver Bohemia Colección <span aria-hidden="true">↗</span></a
        >
      </div>
    </article>
    <article class="timeline-item">
      <div class="timeline-date">
        SEPTIEMBRE 2024<span>Curso completado</span>
      </div>
      <div>
        <h3>JavaScript Total</h3>
        <p class="organization">Federico Garay · Udemy</p>
        <p class="course-description">
          Formación complementaria en JavaScript tras finalizar el ciclo de
          Desarrollo de Aplicaciones Web.
        </p>
        <a
          class="text-link"
          href="https://udemy-certificate.s3.amazonaws.com/image/UC-f0b4befa-4b3e-41f0-ac4f-11d3072c17a9.jpg"
          target="_blank"
          rel="noopener noreferrer"
          >Ver certificado <span aria-hidden="true">↗</span><span
            class="sr-only"
          >
            (abre en otra pestaña)</span
          ></a
        >
      </div>
    </article>
    <article class="timeline-item">
      <div class="timeline-date">
        ABR. — SEPT. 2024
        <span>Formación complementaria</span>
      </div>
      <div>
        <h3>Formación en Angular</h3>
        <p class="organization">Fernando Herrera · DevTalles</p>
        <p class="course-description">
          Ampliación de conocimientos de Angular mediante el seguimiento parcial
          de cursos y ejercicios prácticos.
        </p>
      </div>
    </article>
    <article class="timeline-item">
      <div class="timeline-date">
        MAR. — MAY. 2024<span>Prácticas de DAW</span>
      </div>
      <div>
        <h3>Desarrolladora web en prácticas</h3><p class="organization">
          Plexus Tech
        </p>
        <ul class="bullet-list">
          <li>
            Componentes reutilizables con Angular en un entorno de
            microfrontends.
          </li><li>
            Comunicación con @Input y @Output y creación de pipes
            personalizados.
          </li><li>
            Consumo de APIs con HttpClient y control de versiones con Git y
            GitHub.
          </li>
        </ul>
      </div>
    </article>
  </div>
</Section>
