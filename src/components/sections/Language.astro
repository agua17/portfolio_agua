---
import Section from '../Section.astro'
const groups = [
  { context: 'PRÁCTICA ACTUAL', title: 'Bases e interacción', description: 'Ejercicios e interfaces con eventos, formularios y manipulación del DOM.', items: ['JavaScript', 'HTML', 'CSS', 'Git', 'GitHub'] },
  { context: 'EXPERIENCIA EN PRÁCTICAS', title: 'Angular en Plexus', description: 'Tecnologías utilizadas durante mis prácticas de DAW en 2024.', items: ['Angular', 'TypeScript', 'HttpClient'] },
  { context: 'UTILIZADAS EN PROYECTOS', title: 'Construcción de webs', description: 'WordPress para negocios y Astro y Tailwind CSS en este portfolio.', items: ['WordPress', 'Astro', 'Tailwind CSS'] }
]
---
<Section id="tecnologias" title="Tecnologías con contexto" eyebrow="CONOCIMIENTOS">
  <div class="technology-grid">
    {groups.map(group => <article class="technology-group">
      <p class="eyebrow">{group.context}</p><h3>{group.title}</h3><p>{group.description}</p>
      <ul class="tags" aria-label={group.title}>{group.items.map(item => <li>{item}</li>)}</ul>
    </article>)}
  </div>
</Section>
