---
import { Image } from "astro:assets"
import portrait from "../../assets/foto_perfil.png"
const base = import.meta.env.BASE_URL
---

<section class="hero" aria-labelledby="intro-title">
  <div class="hero-copy">
    <p class="eyebrow">DESARROLLADORA FRONTEND JUNIOR · SEVILLA</p>
    <h1 id="intro-title">Aguas Santas<br /><span>Núñez Fresco</span></h1>
    <p class="hero-description">
      Desarrollo web con JavaScript y WordPress. Formación en DAW y experiencia
      de prácticas con Angular en Plexus Tech.
    </p>
    <div class="actions">
      <a class="button primary" href="#proyectos"
        >Ver mis proyectos <span aria-hidden="true">↗</span></a
      >
      <a
        class="button secondary"
        href={base + "CV_Aguas_Santas_Frontend.pdf"}
        download>Descargar CV <span aria-hidden="true">↓</span></a
      >
    </div>
    <p class="hero-note">
      Busco una oportunidad para incorporarme a un equipo frontend.
    </p>
  </div>
  <div class="hero-portrait">
    <div class="portrait-frame">
      <Image
        src={portrait}
        alt="Aguas Santas Núñez Fresco"
        width={340}
        height={340}
        loading="eager"
      />
    </div>
    <div class="portrait-caption">
      <span class="dot" aria-hidden="true"></span> Los Palacios y Villafranca, Sevilla
    </div>
  </div>
</section>
