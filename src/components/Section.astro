---
interface Props {
  title: string
  id: string
  eyebrow?: string
}
const { title, id, eyebrow } = Astro.props
---
<section id={id} class="section" aria-labelledby={id + '-title'}>
  <div class="section-heading">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h2 id={id + '-title'}>{title}</h2>
  </div>
  <slot />
</section>
